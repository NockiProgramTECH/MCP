# Copy this file to .env for local development. Never commit .env.
# Tokens are intentionally empty; configure only the services you use.
GITHUB_TOKEN=
LINKEDIN_ACCESS_TOKEN=
META_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# Optional Meta Graph API version. Keep the default unless the official docs require another version.
OPENCLAW_MCP_META_GRAPH_API_VERSION=v26.0

# Server settings
OPENCLAW_MCP_LOG_LEVEL=INFO
OPENCLAW_MCP_HTTP_TIMEOUT_SECONDS=15
OPENCLAW_MCP_MAX_RETRIES=2
